{
  "project_name": "Star Catcher",
  "version": "1.0.0",
  "input_actions": {
    "left": [
      "key:ArrowLeft",
      "key:A",
      "pad:left",
      "pad:left_x-"
    ],
    "right": [
      "key:ArrowRight",
      "key:D",
      "pad:right",
      "pad:left_x+"
    ],
    "start": [
      "key:Space",
      "key:Enter",
      "pad:a",
      "pad:start"
    ],
    "back": [
      "key:Escape",
      "pad:b"
    ]
  }
}
